{
  "name": "@luna-estelar/gas-browser",
  "version": "0.2.0",
  "description": "Browser host for GAS sessions: prebuffered Web Audio playback, session composition, and timeline view models.",
  "keywords": [
    "gas",
    "generative-audio",
    "music",
    "browser",
    "web-audio"
  ],
  "homepage": "https://gas.lunaestelar.com",
  "bugs": {
    "url": "https://github.com/luna-estelar/gas/issues"
  },
  "license": "MIT",
  "author": "sathira10 (https://github.com/sathira10)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/luna-estelar/gas.git",
    "directory": "packages/browser"
  },
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "sideEffects": false,
  "engines": {
    "node": ">=22.0.0"
  },
  "exports": {
    "./session": {
      "types": "./out/session.d.ts",
      "default": "./out/session.js"
    },
    "./audio": {
      "types": "./out/audio/index.d.ts",
      "default": "./out/audio/index.js"
    },
    "./capture": {
      "types": "./out/capture.d.ts",
      "default": "./out/capture.js"
    },
    "./compile": {
      "types": "./out/compile.d.ts",
      "default": "./out/compile.js"
    },
    "./timeline": {
      "types": "./out/timeline.d.ts",
      "default": "./out/timeline.js"
    },
    "./inspect": {
      "types": "./out/inspect.d.ts",
      "default": "./out/inspect.js"
    }
  },
  "files": [
    "out",
    "src"
  ],
  "scripts": {
    "clean": "tsc -b --clean"
  },
  "dependencies": {
    "@luna-estelar/gas-api": "workspace:^",
    "@luna-estelar/gas-core": "workspace:^",
    "@luna-estelar/gas-language": "workspace:^",
    "@luna-estelar/gas-protocol": "workspace:^",
    "@luna-estelar/gas-renderer": "workspace:^"
  }
}
