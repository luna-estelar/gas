{
  "name": "@luna-estelar/gas-browser",
  "version": "0.1.0",
  "description": "Browser-host composition, Web Audio playback, and framework-free UI view models for GAS sessions.",
  "keywords": [
    "gas",
    "generative-audio",
    "music",
    "browser",
    "web-audio"
  ],
  "homepage": "https://gas.lunaestelar.com",
  "bugs": {
    "url": "https://github.com/luna-estelar/gas/issues"
  },
  "license": "MIT",
  "author": "sathira10 (https://github.com/sathira10)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/luna-estelar/gas.git",
    "directory": "packages/browser"
  },
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "sideEffects": false,
  "engines": {
    "node": ">=22.0.0"
  },
  "exports": {
    "./access": {
      "types": "./out/access.d.ts",
      "default": "./out/access.js"
    },
    "./audio": {
      "types": "./out/audio.d.ts",
      "default": "./out/audio.js"
    },
    "./config": {
      "types": "./out/config.d.ts",
      "default": "./out/config.js"
    },
    "./playback": {
      "types": "./out/playback.d.ts",
      "default": "./out/playback.js"
    },
    "./timeline": {
      "types": "./out/timeline.d.ts",
      "default": "./out/timeline.js"
    },
    "./inspect": {
      "types": "./out/inspect.d.ts",
      "default": "./out/inspect.js"
    },
    "./wiring": {
      "types": "./out/wiring.d.ts",
      "default": "./out/wiring.js"
    },
    "./compile": {
      "types": "./out/compile.d.ts",
      "default": "./out/compile.js"
    },
    "./bitsy/types": {
      "types": "./out/bitsy/types.d.ts",
      "default": "./out/bitsy/types.js"
    },
    "./bitsy/bridge": {
      "types": "./out/bitsy/bridge.d.ts",
      "default": "./out/bitsy/bridge.js"
    },
    "./bitsy/score": {
      "types": "./out/bitsy/score.d.ts",
      "default": "./out/bitsy/score.js"
    },
    "./bitsy/controller": {
      "types": "./out/bitsy/controller.d.ts",
      "default": "./out/bitsy/controller.js"
    }
  },
  "files": [
    "out",
    "src"
  ],
  "scripts": {
    "clean": "tsc -b --clean"
  },
  "dependencies": {
    "@luna-estelar/gas-api": "workspace:*",
    "@luna-estelar/gas-connector-lyria": "workspace:*",
    "@luna-estelar/gas-core": "workspace:*",
    "@luna-estelar/gas-language": "workspace:*",
    "@luna-estelar/gas-protocol": "workspace:*",
    "@luna-estelar/gas-renderer": "workspace:*"
  }
}
