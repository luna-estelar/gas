{
  "name": "@luna-estelar/gas-magenta-rt2",
  "version": "0.1.0",
  "private": true,
  "description": "Play GAS through Magenta RealTime 2: turns tracks, tempo and sections into live style prompts for a local or hosted MRT2 bridge.",
  "keywords": [
    "gas",
    "magenta",
    "magenta-realtime",
    "mrt2",
    "generative-music",
    "ai-music"
  ],
  "homepage": "https://gas.lunaestelar.com",
  "bugs": {
    "url": "https://github.com/luna-estelar/gas/issues"
  },
  "license": "MIT",
  "author": "sathira10 (https://github.com/sathira10)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/luna-estelar/gas.git",
    "directory": "packages/magenta-rt2"
  },
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "sideEffects": false,
  "engines": {
    "node": ">=22.0.0"
  },
  "main": "./out/index.js",
  "module": "./out/index.js",
  "types": "./out/index.d.ts",
  "exports": {
    ".": {
      "types": "./out/index.d.ts",
      "default": "./out/index.js"
    }
  },
  "files": [
    "out",
    "src"
  ],
  "scripts": {
    "clean": "tsc -b --clean",
    "manual:listen": "node manual/listen.mjs"
  },
  "devDependencies": {
    "@luna-estelar/gas": "workspace:^"
  },
  "peerDependencies": {
    "@luna-estelar/gas": ">=0.3.0 <1.0.0"
  }
}
