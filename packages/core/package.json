{
  "name": "@luna-estelar/gas-core",
  "version": "0.2.1",
  "description": "Session state and musical time for GAS: apply commands, find what is playing at any bar, and convert bars to seconds.",
  "keywords": [
    "gas",
    "music",
    "session",
    "state"
  ],
  "homepage": "https://gas.lunaestelar.com",
  "bugs": {
    "url": "https://github.com/luna-estelar/gas/issues"
  },
  "license": "MIT",
  "author": "sathira10 (https://github.com/sathira10)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/luna-estelar/gas.git",
    "directory": "packages/core"
  },
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "sideEffects": false,
  "engines": {
    "node": ">=20.0.0"
  },
  "main": "./out/index.js",
  "module": "./out/index.js",
  "types": "./out/index.d.ts",
  "exports": {
    ".": {
      "types": "./out/index.d.ts",
      "default": "./out/index.js"
    }
  },
  "files": [
    "out",
    "src"
  ],
  "scripts": {
    "clean": "tsc -b --clean"
  },
  "dependencies": {
    "@luna-estelar/gas-protocol": "workspace:^"
  }
}
