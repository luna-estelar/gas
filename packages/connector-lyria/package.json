{
  "name": "@luna-estelar/gas-connector-lyria",
  "version": "0.2.1",
  "description": "Drive Google's Lyria RealTime music model from GAS: turns tracks, tempo and sections into Lyria prompts and config.",
  "keywords": [
    "gas",
    "lyria",
    "lyria-realtime",
    "gemini",
    "generative-music",
    "ai-music"
  ],
  "homepage": "https://gas.lunaestelar.com",
  "bugs": {
    "url": "https://github.com/luna-estelar/gas/issues"
  },
  "license": "MIT",
  "author": "sathira10 (https://github.com/sathira10)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/luna-estelar/gas.git",
    "directory": "packages/connector-lyria"
  },
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "sideEffects": false,
  "engines": {
    "node": ">=20.0.0"
  },
  "main": "./out/index.js",
  "module": "./out/index.js",
  "types": "./out/index.d.ts",
  "exports": {
    ".": {
      "types": "./out/index.d.ts",
      "default": "./out/index.js"
    }
  },
  "files": [
    "out",
    "src"
  ],
  "scripts": {
    "clean": "tsc -b --clean",
    "manual:listen": "node manual/listen.mjs",
    "manual:smoke": "node manual/smoke.mjs"
  },
  "dependencies": {
    "@google/genai": "^2.23.0",
    "@luna-estelar/gas-protocol": "workspace:^"
  },
  "devDependencies": {
    "@luna-estelar/gas-core": "workspace:^",
    "@luna-estelar/gas-language": "workspace:^"
  }
}
