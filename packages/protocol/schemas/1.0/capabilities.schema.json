{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://gas.luna-estelar.com/protocol/1.0/capabilities.schema.json",
  "title": "GAS Capabilities Table 1.0",
  "type": "object",
  "additionalProperties": false,
  "required": ["intents"],
  "properties": {
    "intents": {
      "type": "object",
      "additionalProperties": false,
      "required": ["flavor", "key", "tempo", "time_signature", "timbre", "level", "notes", "motif"],
      "properties": {
        "flavor": { "$ref": "#/$defs/IntentSupport" },
        "key": { "$ref": "#/$defs/IntentSupport" },
        "tempo": { "$ref": "#/$defs/IntentSupport" },
        "time_signature": { "$ref": "#/$defs/IntentSupport" },
        "timbre": { "$ref": "#/$defs/IntentSupport" },
        "level": { "$ref": "#/$defs/IntentSupport" },
        "notes": { "$ref": "#/$defs/IntentSupport" },
        "motif": { "$ref": "#/$defs/IntentSupport" }
      }
    }
  },
  "$defs": {
    "IntentSupport": {
      "enum": ["supported", "approximated", "unsupported"]
    },
    "IntentKeyword": {
      "enum": ["flavor", "key", "tempo", "time_signature", "timbre", "level", "notes", "motif"]
    }
  }
}
