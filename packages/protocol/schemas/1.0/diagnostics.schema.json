{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://gas.luna-estelar.com/protocol/1.0/diagnostics.schema.json",
  "title": "GAS Diagnostics 1.0",
  "$defs": {
    "GasDiagnostic": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "category", "severity", "message"],
      "properties": {
        "code": { "type": "string", "minLength": 1 },
        "category": { "enum": ["syntax", "semantic", "deferred", "informational"] },
        "severity": { "enum": ["error", "warning", "info"] },
        "message": { "type": "string", "minLength": 1 },
        "range": { "$ref": "common.schema.json#/$defs/SourceRange" }
      }
    },
    "TimelineProblem": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "message"],
      "properties": {
        "code": {
          "enum": [
            "unsupported-format-version",
            "invalid-shape",
            "duplicate-id",
            "unresolved-reference",
            "position-out-of-range",
            "arrangement-not-contiguous",
            "invalid-level",
            "invalid-playback"
          ]
        },
        "message": { "type": "string", "minLength": 1 }
      }
    },
    "CommandFailure": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "message"],
      "properties": {
        "code": {
          "enum": [
            "duplicate-track",
            "unknown-track",
            "invalid-level",
            "invalid-tempo",
            "invalid-value"
          ]
        },
        "message": { "type": "string", "minLength": 1 },
        "trackId": { "$ref": "common.schema.json#/$defs/NonEmptyString" }
      }
    },
    "CommandWarning": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "intent", "support", "message"],
      "properties": {
        "code": { "const": "unsupported-intent" },
        "intent": { "$ref": "capabilities.schema.json#/$defs/IntentKeyword" },
        "support": { "enum": ["approximated", "unsupported"] },
        "trackId": { "$ref": "common.schema.json#/$defs/NonEmptyString" },
        "message": { "type": "string", "minLength": 1 }
      }
    },
    "RendererWarning": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "message"],
      "properties": {
        "code": { "type": "string", "minLength": 1 },
        "message": { "type": "string", "minLength": 1 },
        "runId": { "$ref": "common.schema.json#/$defs/NonEmptyString" }
      }
    },
    "RendererFailure": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "message", "retryable"],
      "properties": {
        "code": { "type": "string", "minLength": 1 },
        "message": { "type": "string", "minLength": 1 },
        "reason": { "enum": ["network", "auth", "quota", "provider", "internal"] },
        "runId": { "$ref": "common.schema.json#/$defs/NonEmptyString" },
        "retryable": { "type": "boolean" }
      }
    }
  }
}
