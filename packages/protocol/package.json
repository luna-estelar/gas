{
  "name": "@luna-estelar/gas-protocol",
  "version": "0.1.0",
  "description": "Shared, transport-neutral payload schemas and types used across the GAS packages.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "main": "./out/index.js",
  "module": "./out/index.js",
  "types": "./out/index.d.ts",
  "exports": {
    ".": {
      "types": "./out/index.d.ts",
      "default": "./out/index.js"
    },
    "./validation": {
      "types": "./out/validation.d.ts",
      "default": "./out/validation.js"
    },
    "./schemas/1.0/*": "./schemas/1.0/*"
  },
  "files": [
    "out",
    "src",
    "schemas"
  ],
  "scripts": {
    "clean": "tsc -b --clean"
  },
  "dependencies": {
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1"
  }
}
