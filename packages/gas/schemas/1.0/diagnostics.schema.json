{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://gas.luna-estelar.com/protocol/1.0/diagnostics.schema.json",
  "title": "GAS Diagnostics 1.0",
  "$defs": {
    "GasDiagnostic": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "category", "severity", "message"],
      "properties": {
        "code": { "type": "string", "minLength": 1 },
        "category": { "enum": ["syntax", "semantic", "deferred", "informational"] },
        "severity": { "enum": ["error", "warning", "info"] },
        "message": { "type": "string", "minLength": 1 },
        "range": { "$ref": "common.schema.json#/$defs/SourceRange" }
      }
    },
    "TimelineProblem": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "message"],
      "properties": {
        "code": {
          "enum": [
            "unsupported-format-version",
            "invalid-shape",
            "duplicate-id",
            "unresolved-reference",
            "position-out-of-range",
            "arrangement-not-contiguous",
            "invalid-level",
            "invalid-playback",
            "events-unordered",
            "sequence-collision",
            "beat-out-of-range",
            "event-outside-section"
          ]
        },
        "message": { "type": "string", "minLength": 1 }
      }
    },
    "CommandFailure": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "message"],
      "properties": {
        "code": {
          "enum": [
            "duplicate-track",
            "unknown-track",
            "not-app-track",
            "invalid-level",
            "invalid-tempo",
            "invalid-value"
          ]
        },
        "message": { "type": "string", "minLength": 1 },
        "trackId": { "$ref": "common.schema.json#/$defs/NonEmptyString" }
      }
    },
    "CommandWarning": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "intent", "support", "message"],
      "properties": {
        "code": { "const": "unsupported-intent" },
        "intent": { "$ref": "capabilities.schema.json#/$defs/IntentKeyword" },
        "support": { "enum": ["approximated", "unsupported"] },
        "trackId": { "$ref": "common.schema.json#/$defs/NonEmptyString" },
        "message": { "type": "string", "minLength": 1 }
      }
    },
    "AppValueDroppedWarning": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "trackId", "command", "message"],
      "properties": {
        "code": { "const": "app-value-dropped" },
        "trackId": { "$ref": "common.schema.json#/$defs/NonEmptyString" },
        "command": { "$ref": "commands.schema.json#/$defs/OverrideCommand" },
        "message": { "type": "string", "minLength": 1 }
      }
    }
  }
}
