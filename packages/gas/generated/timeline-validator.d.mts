// Types for the validator generated by scripts/build-validators.mjs. Declared
// structurally so the protocol package does not carry ajv's types into its
// public declarations; the problem shape matches what ajv reports.

export interface GeneratedValidationError {
  readonly instancePath: string;
  readonly schemaPath: string;
  readonly keyword: string;
  readonly message?: string;
}

export interface GeneratedValidator {
  (data: unknown): boolean;
  errors?: readonly GeneratedValidationError[] | null;
}

export declare const validateTimeline: GeneratedValidator;
