{
  "name": "@luna-estelar/gas",
  "version": "0.2.0",
  "description": "Write music structure as code: tempo, sections and tracks in a small language, played live through generative music models such as Lyria RealTime.",
  "keywords": [
    "gas",
    "generative-music",
    "ai-music",
    "music-generation",
    "lyria",
    "lyria-realtime",
    "dsl",
    "live-coding",
    "web-audio",
    "text-to-music"
  ],
  "homepage": "https://gas.lunaestelar.com",
  "bugs": {
    "url": "https://github.com/luna-estelar/gas/issues"
  },
  "license": "MIT",
  "author": "sathira10 (https://github.com/sathira10)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/luna-estelar/gas.git",
    "directory": "packages/gas"
  },
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "sideEffects": false,
  "engines": {
    "node": ">=22.0.0"
  },
  "main": "./out/index.js",
  "module": "./out/index.js",
  "types": "./out/index.d.ts",
  "bin": {
    "gas": "./bin/gas.js"
  },
  "exports": {
    ".": {
      "types": "./out/index.d.ts",
      "default": "./out/index.js"
    },
    "./language": {
      "types": "./out/language.d.ts",
      "default": "./out/language.js"
    },
    "./browser": {
      "types": "./out/browser.d.ts",
      "default": "./out/browser.js"
    },
    "./protocol": {
      "types": "./out/protocol.d.ts",
      "default": "./out/protocol.js"
    },
    "./protocol/validation": {
      "types": "./out/protocol-validation.d.ts",
      "default": "./out/protocol-validation.js"
    },
    "./highlight": {
      "types": "./out/highlight.d.ts",
      "default": "./out/highlight.js"
    },
    "./protocol/schemas/1.0/*": "./schemas/1.0/*"
  },
  "files": [
    "bin",
    "out",
    "src",
    "schemas",
    "generated",
    "syntaxes"
  ],
  "scripts": {
    "clean": "tsc -b --clean",
    "langium:generate": "langium generate",
    "langium:watch": "langium generate --watch"
  },
  "dependencies": {
    "ajv": "^8.20.0",
    "chevrotain": "~12.0.0",
    "langium": "~4.2.0"
  },
  "devDependencies": {
    "langium-cli": "~4.2.0"
  }
}
