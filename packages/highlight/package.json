{
  "name": "@luna-estelar/gas-highlight",
  "version": "0.1.0",
  "description": "Pure GAS syntax-presentation helpers for highlighted source and documentation fences.",
  "keywords": [
    "gas",
    "generative-audio",
    "music",
    "syntax-highlighting",
    "tokenizer"
  ],
  "homepage": "https://gas.lunaestelar.com",
  "bugs": {
    "url": "https://github.com/luna-estelar/gas/issues"
  },
  "license": "MIT",
  "author": "sathira10 (https://github.com/sathira10)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/luna-estelar/gas.git",
    "directory": "packages/highlight"
  },
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "sideEffects": false,
  "engines": {
    "node": ">=22.0.0"
  },
  "main": "./out/index.js",
  "module": "./out/index.js",
  "types": "./out/index.d.ts",
  "exports": {
