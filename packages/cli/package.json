{
  "name": "@luna-estelar/gas-cli",
  "version": "0.1.0",
  "description": "Command-line entrypoint for GAS.",
  "keywords": [
    "gas",
    "generative-audio",
    "music",
    "cli",
    "compiler"
  ],
  "homepage": "https://gas.lunaestelar.com",
  "bugs": {
    "url": "https://github.com/luna-estelar/gas/issues"
  },
  "license": "MIT",
  "author": "sathira10 (https://github.com/sathira10)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/luna-estelar/gas.git",
    "directory": "packages/cli"
  },
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "engines": {
    "node": ">=22.0.0"
  },
  "main": "./out/index.js",
  "module": "./out/index.js",
  "types": "./out/index.d.ts",
  "exports": {
    ".": {
      "types": "./out/index.d.ts",
      "default": "./out/index.js"
    }
  },
  "bin": {
    "gas": "./bin/gas.js"
  },
  "files": [
    "bin",
    "out",
    "src"
  ],
  "scripts": {
    "clean": "tsc -b --clean"
  },
  "dependencies": {
    "@luna-estelar/gas-protocol": "workspace:*",
    "@luna-estelar/gas-language": "workspace:*",
    "@luna-estelar/gas-core": "workspace:*"
  }
}
