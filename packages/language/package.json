{
  "name": "@luna-estelar/gas-language",
  "version": "0.1.0",
  "description": "Parses, validates, and compiles GAS documents and live fragments into musical-time timelines.",
  "keywords": [
    "gas",
    "generative-audio",
    "music",
    "parser",
    "compiler",
    "dsl"
  ],
  "homepage": "https://gas.lunaestelar.com",
  "bugs": {
    "url": "https://github.com/luna-estelar/gas/issues"
  },
  "license": "MIT",
  "author": "sathira10 (https://github.com/sathira10)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/luna-estelar/gas.git",
    "directory": "packages/language"
  },
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "engines": {
    "node": ">=22.0.0"
  },
  "main": "./out/index.js",
  "module": "./out/index.js",
  "types": "./out/index.d.ts",
  "exports": {
    ".": {
      "types": "./out/index.d.ts",
      "default": "./out/index.js"
    }
  },
  "files": [
    "out",
    "src"
  ],
  "scripts": {
    "build": "pnpm langium:generate && tsc -b",
    "clean": "tsc -b --clean",
    "langium:generate": "langium generate",
    "langium:watch": "langium generate --watch"
  },
  "dependencies": {
    "@luna-estelar/gas-protocol": "workspace:*",
    "chevrotain": "~12.0.0",
    "langium": "~4.2.0"
  },
  "devDependencies": {
    "langium-cli": "~4.2.0"
  }
}
