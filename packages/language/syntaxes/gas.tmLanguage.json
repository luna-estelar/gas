{
  "name": "gas",
  "scopeName": "source.gas",
  "fileTypes": [
    "gas"
  ],
  "patterns": [
    {
      "include": "#comments"
    },
    {
      "name": "keyword.control.gas",
      "match": "\\b(bar|bars|effect|extend|flavor|infinite|key|length|level|loop|lyrics|motif|notes|play|prompt|section|stop|tempo|theme|timbre|time_signature|track)\\b"
    },
    {
      "name": "string.quoted.double.gas",
      "begin": "\"",
      "end": "\"",
      "patterns": [
        {
          "include": "#string-character-escape"
        }
      ]
    },
    {
      "name": "string.quoted.single.gas",
      "begin": "'",
      "end": "'",
      "patterns": [
        {
          "include": "#string-character-escape"
        }
      ]
    }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "begin": "#",
          "beginCaptures": {
            "1": {
              "name": "punctuation.whitespace.comment.leading.gas"
            }
          },
          "end": "(?=$)",
          "name": "comment.line.gas"
        }
      ]
    },
    "string-character-escape": {
      "name": "constant.character.escape.gas",
      "match": "\\\\(x[0-9A-Fa-f]{2}|u[0-9A-Fa-f]{4}|u\\{[0-9A-Fa-f]+\\}|[0-2][0-7]{0,2}|3[0-6][0-7]?|37[0-7]?|[4-7][0-7]?|.|$)"
    }
  }
}
