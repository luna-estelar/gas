{
  "name": "@luna-estelar/gas-renderer",
  "version": "0.1.1",
  "description": "Audio generation and playback: clock, scheduling, musical-to-clock conversion, and session state derived through gas-core.",
  "keywords": [
    "gas",
    "generative-audio",
    "music",
    "renderer",
    "audio",
    "playback"
  ],
  "homepage": "https://gas.lunaestelar.com",
  "bugs": {
    "url": "https://github.com/luna-estelar/gas/issues"
  },
  "license": "MIT",
  "author": "sathira10 (https://github.com/sathira10)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/luna-estelar/gas.git",
    "directory": "packages/renderer"
  },
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "sideEffects": false,
  "engines": {
    "node": ">=20.0.0"
  },
  "main": "./out/index.js",
  "module": "./out/index.js",
  "types": "./out/index.d.ts",
  "exports": {
    ".": {
      "types": "./out/index.d.ts",
      "default": "./out/index.js"
    }
  },
  "files": [
    "out",
    "src"
  ],
  "scripts": {
    "clean": "tsc -b --clean"
  },
  "dependencies": {
    "@luna-estelar/gas-core": "workspace:*",
    "@luna-estelar/gas-notation": "workspace:*",
    "@luna-estelar/gas-protocol": "workspace:*",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1"
  }
}
