{
  "name": "gas",
  "version": "0.1.0",
  "description": "GAS — a readable language and runtime for controlling generative audio models.",
  "homepage": "https://gas.lunaestelar.com",
  "bugs": {
    "url": "https://github.com/luna-estelar/gas/issues"
  },
  "license": "MIT",
  "author": "sathira10 (https://github.com/sathira10)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/luna-estelar/gas.git"
  },
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.1.2",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "build": "tsc -b",
    "clean": "tsc -b --clean",
    "check:schemas": "node scripts/validate-schemas.mjs",
    "build:validators": "node scripts/build-validators.mjs",
    "check:validators": "node scripts/build-validators.mjs --check",
    "check:boundaries": "node scripts/check-boundaries.mjs",
    "format": "node scripts/format.mjs --write",
    "format:check": "node scripts/format.mjs --check",
    "check:publish": "node scripts/check-publish.mjs",
    "check:security": "pnpm audit --prod --audit-level high",
    "test": "pnpm format:check && pnpm build && pnpm check:schemas && pnpm check:validators && pnpm check:boundaries && pnpm check:publish && vitest run"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@luna-estelar/gas-browser": "workspace:*",
    "@types/node": "^22.10.0",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "prettier": "^3.8.5",
    "publint": "^0.3.24",
    "typescript": "^5.5.0",
    "vitest": "^3.2.6"
  }
}
