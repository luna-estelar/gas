{
  "name": "gas",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "description": "GAS — a readable language and runtime for controlling generative audio models.",
  "packageManager": "pnpm@11.1.2",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "build": "tsc -b",
    "clean": "tsc -b --clean",
    "check:schemas": "node scripts/validate-schemas.mjs",
    "check:boundaries": "node scripts/check-boundaries.mjs",
    "test": "pnpm build && pnpm check:schemas && pnpm check:boundaries && vitest run"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "prettier": "^3.8.5",
    "typescript": "^5.5.0",
    "vitest": "^2.0.0"
  }
}
